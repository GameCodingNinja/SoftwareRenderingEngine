<objectDataList3D>

  <!-- DEFAULT DEFAULT DEFAULT DEFAULT DEFAULT DEFAULT DEFAULT DEFAULT -->
  <default  name="">
    <visual>
      <texture file=""/>
      <mesh genType="quad">
        <quad uv.x1="0" uv.y1="0" uv.x2="1" uv.y2="1"/>
        <mesh file=""/>
      </mesh>
      <color r="1" g="1" b="1" a="1"/>
      <shader name="default"/>
      <fixedFunction enable="false" blendAlpha="false"/>
    </visual>
    <physics file="" world="" type="static">
      <size width="0" height="0"/>
      <sizeMod top="0" bottom="0" left="0" right="0"/>
      <body density="0" restitution="0" damping="0" angDamping="0" fixedRotation="false"/>
    </physics>
    <scale x="1" y="1" z="1"/>
    <size width="0" height="0"/>
  </default>
  <!-- DEFAULT DEFAULT DEFAULT DEFAULT DEFAULT DEFAULT DEFAULT DEFAULT -->
  
  <objectList>

    <object name="logo">
      <visual>
          <texture file="data/textures/titleScreen/logo.png"/>
          <shader name="default"/>
      </visual>
    </object>

    <object name="cube">
      <visual>
        <texture file="data/textures/3d/cube.png"/>
        <mesh genType="mesh">
          <mesh file="data/objects/3d/mesh/cube.obj"/>
          <shader name="default"/>
        </mesh>
      </visual>
    </object>

  </objectList>

</objectDataList3D>

