# Cube with individual texture per face
mtllib cube_multi.mtl
o Cube

# Vertices
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0

# Texture coordinates (full 0-1 per face)
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normals
vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

usemtl FrontMat
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

usemtl BackMat
f 6/1/2 5/2/2 8/3/2
f 6/1/2 8/3/2 7/4/2

usemtl RightMat
f 2/1/3 6/2/3 7/3/3
f 2/1/3 7/3/3 3/4/3

usemtl LeftMat
f 5/1/4 1/2/4 4/3/4
f 5/1/4 4/3/4 8/4/4

usemtl TopMat
f 4/1/5 3/2/5 7/3/5
f 4/1/5 7/3/5 8/4/5

usemtl BottomMat
f 5/1/6 6/2/6 2/3/6
f 5/1/6 2/3/6 1/4/6
