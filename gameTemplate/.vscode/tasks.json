{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make",
            "type": "shell",
            "options": {
                "cwd": "${workspaceRoot}/build"
            },
            "command": "cmake --build .",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "windows": {
                "command": "cmake --build . --config Debug"
            }
        },
        {
            "label": "Multi-core Build",
            "type": "shell",
            "options": {
                "cwd": "${workspaceRoot}/build"
            },
            "command": "cmake --build . --parallel -j4",
            "problemMatcher": [],
            "windows": {
                "command": "cmake --build . --config Debug --parallel"
            }
        },
        {
            "label": "CMake Debug",
            "type": "shell",
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "command": "rm -rfd build; mkdir build; cd build; cmake -DCMAKE_BUILD_TYPE=Debug ..",
            "problemMatcher": [],
            "windows": {
                "command": "if (Test-Path build) { Remove-Item -Recurse -Force build }; cmake -S . -B build"
            }
        },
        {
            "label": "CMake Release",
            "type": "shell",
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "command": "rm -rfd build; mkdir build; cd build; cmake -DCMAKE_BUILD_TYPE=Release ..",
            "problemMatcher": [],
            "windows": {
                "command": "if (Test-Path build) { Remove-Item -Recurse -Force build }; cmake -S . -B build"
            }
        },
        {
            "label": "Clean",
            "type": "shell",
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "command": "rm -rfd build; rm -rfd ${workspaceRoot}/../library/build",
            "problemMatcher": [],
            "windows": {
                "command": "if (Test-Path build) { Remove-Item -Recurse -Force build }; if (Test-Path ..\\library\\build) { Remove-Item -Recurse -Force ..\\library\\build }"
            }
        },
        {
            "label": "Execute",
            "type": "shell",
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "command": "${workspaceRoot}/build/source/gametemplate",
            "problemMatcher": [],
            "windows": {
                "command": ".\\build\\source\\Debug\\gametemplate.exe"
            }
        }
    ]
}
